{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Emit is discarded: Vite builds the app. This project exists so the host code is
    // type-checked under both compilers like everything else.
    "outDir": "../../.tsbuild/host-demo",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "jsx": "react-jsx",
    "tsBuildInfoFile": "../../.tsbuild/host-demo.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/react" },
    { "path": "../../packages/themes" }
  ]
}
