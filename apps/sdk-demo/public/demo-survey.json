{
  "schemaVersion": 1,
  "title": "Kajay product feedback",
  "description": "A multi-page survey loaded, validated, and submitted through the selected SDK runtime.",
  "checkErrorsMode": "onNextPage",
  "showProgressBar": "top",
  "progressBarType": "requiredQuestions",
  "completedHtml": "<h3>Thank you, {name}.</h3><p>Your response is ready for the host application.</p>",
  "calculatedValues": [
    {
      "name": "profileComplete",
      "expression": "{name} notempty and {email} notempty",
      "includeIntoResult": true
    }
  ],
  "pages": [
    {
      "name": "profile",
      "title": "Your profile",
      "elements": [
        {
          "type": "text",
          "name": "name",
          "title": "What should we call you?",
          "isRequired": true
        },
        {
          "type": "text",
          "name": "email",
          "title": "Work email",
          "isRequired": true,
          "validators": [{ "type": "emailvalidator" }]
        },
        {
          "type": "radiogroup",
          "name": "role",
          "title": "Your primary role",
          "choices": ["Engineer", "Designer", "Product manager", "Other"]
        }
      ]
    },
    {
      "name": "feedback",
      "title": "Product feedback",
      "elements": [
        {
          "type": "rating",
          "name": "rating",
          "title": "How would you rate the experience?",
          "isRequired": true,
          "rateMax": 5,
          "correctAnswer": 5
        },
        {
          "type": "comment",
          "name": "comments",
          "title": "What could we improve?",
          "visibleIf": "{rating} < 5",
          "validators": [
            {
              "type": "textvalidator",
              "minLength": 5,
              "text": "Please give us at least five characters of detail."
            }
          ]
        }
      ]
    }
  ]
}
