{
  "contractVersion": 2,
  "scenarios": [
    {
      "id": "host-values-resolve-including-descent-into-structured-values",
      "definition": {
        "calculatedValues": [
          { "name": "tierEcho", "expression": "{$tier}", "includeIntoResult": true },
          { "name": "planTier", "expression": "{$profile.plan.tier}", "includeIntoResult": true }
        ],
        "pages": [
          { "name": "p1", "elements": [{ "type": "text", "name": "plan" }] }
        ]
      },
      "hostValues": {
        "tier": "gold",
        "profile": { "plan": { "tier": "silver" } }
      },
      "expectInitial": { "state": "running", "diagnostics": [] },
      "steps": [
        {
          "action": {
            "kind": "set-host-value",
            "name": "profile",
            "value": { "plan": { "tier": "platinum" } }
          },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "planTier",
                "previousValue": { "kind": "json", "value": "silver" },
                "value": { "kind": "json", "value": "platinum" }
              }
            ]
          }
        },
        {
          "action": { "kind": "set-host-value", "name": "tier", "value": "gold" },
          "expect": { "state": "running", "events": [] }
        }
      ]
    },
    {
      "id": "a-host-value-write-recomputes-without-being-an-answer-change",
      "definition": {
        "calculatedValues": [
          { "name": "tierEcho", "expression": "{$tier}", "includeIntoResult": true }
        ],
        "pages": [
          { "name": "p1", "elements": [{ "type": "text", "name": "plan" }] }
        ]
      },
      "hostValues": { "tier": "bronze" },
      "expectInitial": { "state": "running", "diagnostics": [] },
      "steps": [
        {
          "action": { "kind": "set-host-value", "name": "tier", "value": "gold" },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "tierEcho",
                "previousValue": { "kind": "json", "value": "bronze" },
                "value": { "kind": "json", "value": "gold" }
              }
            ]
          }
        },
        {
          "action": { "kind": "set-host-value", "name": "tier", "value": "gold" },
          "expect": { "state": "running", "events": [] }
        }
      ]
    },
    {
      "id": "the-host-scope-and-the-answer-scope-are-independent",
      "definition": {
        "calculatedValues": [
          { "name": "answerEcho", "expression": "{tier}", "includeIntoResult": true },
          { "name": "hostEcho", "expression": "{$tier}", "includeIntoResult": true }
        ],
        "pages": [
          { "name": "p1", "elements": [{ "type": "text", "name": "tier" }] }
        ]
      },
      "hostValues": { "tier": "gold" },
      "expectInitial": { "state": "running", "diagnostics": [] },
      "steps": [
        {
          "action": { "kind": "set-value", "name": "tier", "value": "bronze" },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "tier",
                "previousValue": { "kind": "undefined" },
                "value": { "kind": "json", "value": "bronze" }
              },
              {
                "type": "value-changed",
                "name": "answerEcho",
                "previousValue": { "kind": "undefined" },
                "value": { "kind": "json", "value": "bronze" }
              }
            ]
          }
        },
        {
          "action": { "kind": "set-host-value", "name": "tier", "value": "platinum" },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "hostEcho",
                "previousValue": { "kind": "json", "value": "gold" },
                "value": { "kind": "json", "value": "platinum" }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "portable-pattern-matches-and-rejects",
      "definition": {
        "pages": [
          {
            "name": "p1",
            "elements": [
              {
                "type": "text",
                "name": "code",
                "validators": [
                  { "type": "regexvalidator", "regex": "^(KJ|QZ)-[A-Z]{2}\\d{4}$" }
                ]
              }
            ]
          }
        ]
      },
      "expectInitial": { "state": "running", "diagnostics": [] },
      "steps": [
        {
          "action": { "kind": "set-value", "name": "code", "value": "KJ-AB0042" },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "code",
                "previousValue": { "kind": "undefined" },
                "value": { "kind": "json", "value": "KJ-AB0042" }
              }
            ]
          }
        },
        {
          "action": { "kind": "validate-current-page" },
          "expect": {
            "state": "running",
            "events": [],
            "observation": { "kind": "validation", "isValid": true, "errors": [] }
          }
        },
        {
          "action": { "kind": "set-value", "name": "code", "value": "KJ-ab0042" },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "code",
                "previousValue": { "kind": "json", "value": "KJ-AB0042" },
                "value": { "kind": "json", "value": "KJ-ab0042" }
              }
            ]
          }
        },
        {
          "action": { "kind": "validate-current-page" },
          "expect": {
            "state": "running",
            "events": [],
            "observation": {
              "kind": "validation",
              "isValid": false,
              "errors": [{ "name": "code", "kind": "regexvalidator" }]
            }
          }
        }
      ]
    },
    {
      "id": "pattern-searches-unless-anchored",
      "definition": {
        "pages": [
          {
            "name": "p1",
