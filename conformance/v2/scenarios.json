            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "code",
                "previousValue": { "kind": "undefined" },
                "value": { "kind": "json", "value": "prefix KJ-42 suffix" }
              }
            ]
          }
        },
        {
          "action": { "kind": "validate-current-page" },
          "expect": {
            "state": "running",
            "events": [],
            "observation": { "kind": "validation", "isValid": true, "errors": [] }
          }
        }
      ]
    },
    {
      "id": "pattern-classes-and-dot-use-defined-scalars",
      "definition": {
        "pages": [
          {
            "name": "p1",
            "elements": [
              {
                "type": "text",
                "name": "asciiDigit",
                "validators": [{ "type": "regexvalidator", "regex": "^\\d$" }]
              },
              {
                "type": "text",
                "name": "oneScalar",
                "validators": [{ "type": "regexvalidator", "regex": "^.$" }]
              }
            ]
          }
        ]
      },
      "expectInitial": { "state": "running", "diagnostics": [] },
      "steps": [
        {
          "action": { "kind": "set-value", "name": "asciiDigit", "value": "٤" },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "asciiDigit",
                "previousValue": { "kind": "undefined" },
                "value": { "kind": "json", "value": "٤" }
              }
            ]
          }
        },
        {
          "action": { "kind": "set-value", "name": "oneScalar", "value": "😀" },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "oneScalar",
                "previousValue": { "kind": "undefined" },
                "value": { "kind": "json", "value": "😀" }
              }
            ]
          }
        },
        {
          "action": { "kind": "validate-current-page" },
          "expect": {
            "state": "running",
            "events": [],
            "observation": {
              "kind": "validation",
              "isValid": false,
              "errors": [{ "name": "asciiDigit", "kind": "regexvalidator" }]
            }
          }
        }
      ]
    },
    {
      "id": "invalid-pattern-is-an-author-error-not-a-respondent-rule",
      "definition": {
        "pages": [
          {
            "name": "p1",
            "elements": [
              {
                "type": "text",
                "name": "code",
                "validators": [{ "type": "regexvalidator", "regex": "(?=KJ-)KJ-\\d+" }]
              }
            ]
          }
        ]
      },
      "expectInitial": {
        "state": "running",
        "diagnostics": [
          {
            "code": "invalid-pattern",
            "path": "/pages/0/elements/0/validators/0/regex",
            "severity": "error"
          }
        ]
      },
      "steps": [
        {
          "action": { "kind": "set-value", "name": "code", "value": "anything" },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "code",
                "previousValue": { "kind": "undefined" },
                "value": { "kind": "json", "value": "anything" }
              }
            ]
          }
        },
        {
          "action": { "kind": "validate-current-page" },
          "expect": {
            "state": "running",
            "events": [],
            "observation": { "kind": "validation", "isValid": true, "errors": [] }
          }
        }
      ]
    },
    {
      "id": "a-multi-select-is-scored-choice-by-choice",
      "definition": {
        "pages": [
          {
            "name": "p1",
            "elements": [
              {
                "type": "checkbox",
                "name": "picks",
                "choices": ["a", "b", "c"],
                "correctAnswer": ["a", "b"]
              }
            ]
          }
        ]
      },
      "expectInitial": { "state": "running", "diagnostics": [] },
      "steps": [
        {
          "action": { "kind": "set-value", "name": "picks", "value": ["a"] },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "picks",
                "previousValue": { "kind": "undefined" },
                "value": { "kind": "json", "value": ["a"] }
              }
            ]
          }
        },
        {
          "action": { "kind": "measure-score" },
          "expect": {
            "state": "running",
            "events": [],
            "observation": {
              "kind": "score",
              "earned": 1,
              "possible": 2,
              "questionCount": 1,
              "ratio": 0.5
            }
          }
        },
        {
          "action": { "kind": "set-value", "name": "picks", "value": ["a", "b", "c"] },
          "expect": {
            "state": "running",
            "events": [
              {
                "type": "value-changed",
                "name": "picks",
                "previousValue": { "kind": "json", "value": ["a"] },
                "value": { "kind": "json", "value": ["a", "b", "c"] }
              }
            ]
          }
        },
        {
          "action": { "kind": "measure-score" },
          "expect": {
            "state": "running",
            "events": [],
            "observation": {
              "kind": "score",
              "earned": 1,
              "possible": 2,
              "questionCount": 1,
              "ratio": 0.5
            }
          }
        }
      ]
    },
    {
