        "choicesFromQuestion": {
          "type": "string",
          "default": "",
          "description": "Name of a select question whose choices are carried forward."
        },
        "choicesFromQuestionMode": {
          "type": "string",
          "default": "all",
          "description": "all, selected or unselected."
        },
        "choicesByUrl": {
          "type": "string",
          "default": "",
