{
  "name": "kajay-survey-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace root for the Kajay survey engine. Not published.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "tsc -b",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm run build && changeset publish",
    "clean": "tsc -b --clean && rm -rf .tsbuild",
    "lint": "oxlint --deny-warnings",
    "typecheck": "pnpm run typecheck:tsc7 && pnpm run typecheck:tsc",
    "typecheck:tsc": "tsc -b --force",
    "typecheck:tsc7": "node node_modules/typescript7/bin/tsc -b --force",
    "check:arch": "node scripts/check-arch.mjs",
    "check:test-policy": "node --test scripts/test-policy/*.test.mjs && node scripts/test-policy/check-unit-test-policy.mjs",
    "check:parity": "node --test scripts/lib/parityProofs.test.mjs && node scripts/check-parity-proofs.mjs",
    "check:contract": "node --test scripts/test/jsonSchema2020.test.mjs && node scripts/check-contract.mjs",
    "check:conformance": "node --test scripts/test/conformanceV2Corpus.test.mjs && node scripts/check-conformance-v2-corpus.mjs && node scripts/check-conformance-v2.mjs && node scripts/check-conformance.mjs",
    "check:docs": "node --test scripts/docs/*.test.mjs scripts/docs-quality/*.test.mjs && node scripts/docs-quality/check-docs.mjs",
    "verify:dotnet": "node scripts/verify-dotnet.mjs",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "build:demo": "pnpm --filter @kajay/host-demo run build",
    "test:e2e": "playwright test",
    "test:pack": "node scripts/pack-test.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run check:arch && pnpm run check:test-policy && pnpm run check:parity && pnpm run test:unit && pnpm run test:browser && pnpm run check:contract && pnpm run check:conformance && pnpm run verify:dotnet && pnpm run check:docs && pnpm run test:e2e && pnpm run test:pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.12.1",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
