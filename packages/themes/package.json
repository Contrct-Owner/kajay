{
  "name": "@kajay/themes",
  "version": "1.0.0",
    "type": "module",
  "description": "CSS-variable design tokens and theme presets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Contrct-Owner/kajay.git",
    "directory": "packages/themes"
  },
  "homepage": "https://kajay.io",
  "bugs": "https://github.com/Contrct-Owner/kajay/issues",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/styles.css",
    "./themes/*.css": "./styles/themes/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsc -b"
  }
}
