{
  "name": "@kajay/themes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CSS-variable design tokens and theme presets.",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "exports": {
