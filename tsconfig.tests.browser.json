{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/tests-browser-out",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "tsBuildInfoFile": ".tsbuild/tests-browser.tsbuildinfo"
  },
  "include": [
    "packages/*/test/browser/**/*.ts",
    "packages/*/test/browser/**/*.tsx",
    "packages/*/test/browser/**/*.d.ts",
    // Applications too, matching what Vitest already collects. The host application is the
    // only place a package's markup and another package's stylesheet may be looked at
    // together, because it is the only thing allowed to depend on both.
    "apps/*/test/browser/**/*.ts",
    "apps/*/test/browser/**/*.tsx",
    "apps/*/test/browser/**/*.d.ts",
    "vitest.config.ts"
  ],
  "references": [
    // The application itself, on the same terms the unit-test project already has it: a
    // browser test may prove the site's own components, and reaching one through the
    // project reference is what keeps it compiled by its own `bundler` resolution rather
    // than pulled raw into this project's `nodenext`.
    { "path": "./apps/site" },
    { "path": "./packages/core" },
    { "path": "./packages/react" },
    { "path": "./packages/creator-core" },
    { "path": "./packages/creator-react" },
    { "path": "./packages/themes" }
  ]
}
