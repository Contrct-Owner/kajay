{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/tests-unit-out",
    "lib": ["es2023"],
    "types": [],
    "isolatedDeclarations": false,
    "tsBuildInfoFile": ".tsbuild/tests-unit.tsbuildinfo"
  },
  "include": [
    "apps/sdk-demo/test/unit/**/*.ts",
    "apps/sdk-demo-api/test/unit/**/*.ts",
    "packages/*/test/unit/**/*.ts",
    "packages/*/test/support/**/*.ts",
    "packages/*/test/performance/**/*.ts"
  ],
  "references": [
    { "path": "./apps/sdk-demo" },
    { "path": "./apps/sdk-demo-api" },
    { "path": "./packages/core" },
    { "path": "./packages/react" },
    { "path": "./packages/creator-core" },
    { "path": "./packages/creator-react" },
    { "path": "./packages/themes" }
  ]
}
